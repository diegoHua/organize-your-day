# --- Personal runtime state — NEVER commit ---
# These are generated by the agent during use and contain personal data.
# Anchored to the repo root with leading slash so that templates/memory/ etc.
# (which ship as part of the repo) are NOT excluded.
/inbox.md
/plan_actual.md
/bitacora.md
/memory/

# --- Drafts and temporary files ---
*.draft.md
*.tmp
*.bak

# --- Local configuration ---
.env
.env.local
.env.*.local

# --- OS metadata ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code local config ---
.claude/

# --- Node / Python (in case anyone extends with scripts later) ---
node_modules/
__pycache__/
*.pyc
.venv/
